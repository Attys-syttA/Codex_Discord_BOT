# Copy this file to .env and fill in real local values.
# Never commit real Discord tokens or worker shared secrets.

DISCORD_TOKEN=TEST_ONLY_DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=1000000000000000001
DISCORD_GUILD_ID=1000000000000000002
DISCORD_ALLOWED_USER_IDS=1000000000000000003
DISCORD_ALLOWED_ROLE_IDS=

# Relative workspace paths are resolved against the selected worker's workspaceRoot.
DISCORD_CHANNEL_MAPPINGS_JSON=[{"channelId":"1000000000000000004","workspace":"Codex_Discord_BOT","workerId":"otthon"}]
DISCORD_AUTO_WORKSPACE_ALIASES_JSON={"example_discord_bot":"Codex_Discord_BOT"}
DISCORD_WORKERS_JSON=[{"id":"otthon","label":"Otthon worker","baseUrl":"http://127.0.0.1:8787","sharedSecretEnv":"DISCORD_WORKER_SHARED_SECRET_OTTHON","workspaceRoot":".."}]
DISCORD_WORKER_SHARED_SECRET_OTTHON=TEST_ONLY_WORKER_SHARED_SECRET
DISCORD_DEFAULT_WORKER_ID=otthon
DISCORD_WORKER_TIMEOUT_MS=120000
DISCORD_SESSION_STORE_PATH=.discord-bot-state/sessions.json
DISCORD_EPHEMERAL_RESPONSES=true
CODEX_DISCORD_ENV_FILE=.env

DISCORD_REGISTER_COMMANDS=false
DISCORD_LOGIN=false
