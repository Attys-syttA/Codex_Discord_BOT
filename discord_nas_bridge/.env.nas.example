# Copy this file to .env.nas on the NAS and fill in real local values.
# Never commit .env.nas or real Discord tokens / worker shared secrets.

DISCORD_TOKEN=TEST_ONLY_DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=1000000000000000001
DISCORD_GUILD_ID=1000000000000000002
DISCORD_ALLOWED_USER_IDS=1000000000000000003
DISCORD_ALLOWED_ROLE_IDS=

# A workspace itt a worker sajat codex_works gyokerehez kepest relativ repo nev.
DISCORD_CHANNEL_MAPPINGS_JSON=[{"channelId":"1000000000000000004","workspace":"Codex_Discord_BOT","workerId":"otthon"}]
DISCORD_AUTO_WORKSPACE_ALIASES_JSON={"example_discord_bot":"Codex_Discord_BOT"}
DISCORD_WORKERS_JSON=[{"id":"otthon","label":"Otthon worker","baseUrl":"http://HOME_WORKER_IP:8787","sharedSecretEnv":"DISCORD_WORKER_SHARED_SECRET_OTTHON","workspaceRoot":"E:\\codex_works"},{"id":"munkahely","label":"Munkahely worker","baseUrl":"http://WORK_WORKER_IP:8787","sharedSecretEnv":"DISCORD_WORKER_SHARED_SECRET_MUNKAHELY","workspaceRoot":"D:\\codex_works"}]
DISCORD_WORKER_SHARED_SECRET_OTTHON=TEST_ONLY_WORKER_SHARED_SECRET
DISCORD_WORKER_SHARED_SECRET_MUNKAHELY=TEST_ONLY_WORKER_SHARED_SECRET
DISCORD_DEFAULT_WORKER_ID=otthon
DISCORD_WORKER_TIMEOUT_MS=120000
DISCORD_SESSION_STORE_PATH=/data/sessions.json
DISCORD_EPHEMERAL_RESPONSES=false
CODEX_DISCORD_ENV_FILE=.env.nas

DISCORD_REGISTER_COMMANDS=false
DISCORD_LOGIN=true
