DISCORD_APPLICATION_ID=100000000000000010
DISCORD_GUILD_ID=100000000000000001
DISCORD_ALLOWED_USER_IDS=100000000000000999
DISCORD_ALLOWED_ROLE_IDS=

DISCORD_CHANNEL_MAPPINGS_JSON=[{"channelId":"100000000000000101","workspace":"E:\\codex_works\\Codex_Discord_BOT","workerId":"otthon"}]
